  "description": "",
  "organizers": "",
  "targetAudience": "ValorInvalido"
}

### Deletando um mini curso
DELETE {{baseUrl}}/api/minicourses/{{miniCourseId}}

### Deletando um mini curso inexistente (deve retornar 404)
